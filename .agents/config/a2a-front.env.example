# a2a-front — the token ward in front of the collaborator A2A door (plan 192).
# Copy to ~/.config/ymir/a2a-front.env and point the unit at it.
A2A_UPSTREAM=http://127.0.0.1:8301
A2A_LISTEN=127.0.0.1:8400
A2A_AUD=heimdall
# Keys live in the home, never the tree:
#   $YMIR_HOME/hodd/state/a2a/ed25519.key.pem   (0600, mint only)
#   $YMIR_HOME/hodd/state/a2a/ed25519.pub.pem
