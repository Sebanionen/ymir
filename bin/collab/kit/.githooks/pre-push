#!/usr/bin/env bash
# Four things, in the order they are cheapest: never push a protected branch, never push work nobody can
# review, never push a behaviour change without its note, never push a red tree.
#
# The kit goes into Node, Elixir and shell repositories, so the checks are asked of scripts/checks.sh rather
# than named here — and every gate below is reachable: a gate after an `exit` is a gate that never ran.
set -u

protected="master main"
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  bash scripts/gates/pr-guard.sh "${1:-origin}" "$local_ref" "$remote_ref" "$remote_sha" || { fail=1; continue; }

  case "$remote_ref" in
    refs/heads/*)
      branch="${remote_ref#refs/heads/}"
      for p in $protected; do
        if [ "$branch" = "$p" ]; then
          printf 'pre-push refused: %s is protected — open a pull request; the operator seals merges\n' "$branch" >&2
          fail=1
        fi
      done
      # a behaviour change carries its note: the range git is about to send, not a guess at an upstream
      base="$remote_sha"
      case "$base" in ""|0000000000000000000000000000000000000000) base="$(git merge-base "$local_sha" "refs/remotes/${1:-origin}/$protected" 2>/dev/null || true)" ;; esac
      [ -n "$base" ] && bash scripts/gates/fixes-guard.sh "$base" "$local_sha" || true
      ;;
  esac
done

[ "$fail" = 0 ] || exit 1

if [ -f scripts/checks.sh ]; then
  printf 'pre-push: the checks\n'
  bash scripts/checks.sh test || {
    printf '\npre-push refused: a check failed\nhelp: fix it, or push with --no-verify and say why in the commit\n' >&2
    exit 1
  }
else
  printf 'pre-push: scripts/checks.sh is missing — this repository carries an older kit; nothing was checked\n' >&2
fi

exit 0
